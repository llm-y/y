<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory app:title="@string/pref_category_server">

        <Preference
            app:icon="@drawable/ic_lan"
            app:key="server_port"
            app:persistent="false"
            app:title="@string/pref_port_title" />
    </PreferenceCategory>

    <PreferenceCategory app:title="@string/pref_category_background">

        <Preference
            app:icon="@drawable/ic_help"
            app:key="screen_off_guide"
            app:title="@string/pref_guide_title" />

        <Preference
            app:icon="@drawable/ic_battery"
            app:key="battery_optimization"
            app:title="@string/pref_battery_title" />

        <Preference
            app:icon="@drawable/ic_autorenew"
            app:key="background_activity"
            app:title="@string/pref_background_activity_title" />

        <Preference
            app:icon="@drawable/ic_layers"
            app:key="overlay_permission"
            app:title="@string/pref_overlay_permission_title" />
    </PreferenceCategory>

    <PreferenceCategory app:title="@string/pref_category_overlay">

        <SwitchPreferenceCompat
            app:defaultValue="true"
            app:icon="@drawable/ic_picture_in_picture"
            app:key="show_camera_overlay"
            app:summary="@string/pref_show_overlay_summary"
            app:title="@string/pref_show_overlay_title"
            app:widgetLayout="@layout/preference_material_switch" />

        <ListPreference
            app:defaultValue="top_center"
            app:dependency="show_camera_overlay"
            app:entries="@array/overlay_position_entries"
            app:entryValues="@array/overlay_position_values"
            app:icon="@drawable/ic_open_with"
            app:key="overlay_position"
            app:title="@string/pref_overlay_position_title"
            app:useSimpleSummaryProvider="true" />
    </PreferenceCategory>

    <PreferenceCategory app:title="@string/pref_category_about">

        <Preference
            app:icon="@drawable/ic_info"
            app:enableCopying="true"
            app:key="app_version"
            app:title="@string/pref_version_title" />
    </PreferenceCategory>

</PreferenceScreen>
