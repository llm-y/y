    <!-- Panduan layar mati -->
    <string name="guide_title">Screen-off Guide</string>
    <string name="guide_intro">Complete these steps so the camera keeps streaming after you turn the screen off with the power button. Menu names may differ slightly depending on your system version.</string>
    <string name="guide_device_label">Detected device</string>
    <string name="guide_open_settings">Open settings</string>
    <string name="guide_status_done">Done</string>
    <string name="guide_status_pending">Not yet</string>
    <string name="guide_status_restricted">Restricted</string>
    <string name="guide_status_optional">Optional</string>
    <string name="guide_test_title">How to test</string>
    <string name="guide_test_body">Tap Start Server, turn the screen off with the power button, then open the stream URL on your laptop. If the video keeps moving, you\'re all set.</string>
    <string name="guide_open_failed">Settings page not found. Open Settings › Apps › IP Webcam Pro manually.</string>

    <string name="guide_step_battery_title">Ignore battery optimization</string>
    <string name="guide_step_battery_body">Choose <b>Allow</b> in the dialog so Android doesn\'t pause the app when the screen turns off.</string>
    <string name="guide_step_background_title">Allow background activity</string>
    <string name="guide_step_autostart_title">Allow auto launch</string>
    <string name="guide_step_overlay_title">Display over other apps</string>
    <string name="guide_step_overlay_body">Needed to show the camera indicator while streaming in the background.</string>
    <string name="guide_step_lock_title">Lock the app in Recents</string>
    <string name="guide_step_lock_body">Open the <b>Recents</b> screen, long-press or swipe down on the IP Webcam Pro card, then choose <b>Lock</b> so it isn\'t cleared along with other apps.</string>

    <string name="guide_bg_oppo">Tap <b>Battery usage</b>, then turn on <b>Allow background activity</b> and <b>Allow foreground activity</b>.</string>
    <string name="guide_bg_xiaomi">Tap <b>Battery saver</b>, then choose <b>No restrictions</b>.</string>
    <string name="guide_bg_vivo">Open <b>Battery › Background power consumption management</b>, find IP Webcam Pro, then choose <b>Allow</b>.</string>
    <string name="guide_bg_samsung">Tap <b>Battery</b>, then choose <b>Unrestricted</b>. Also make sure the app isn\'t listed under <b>Sleeping apps</b> in Battery › Background usage limits.</string>
    <string name="guide_bg_huawei">Open <b>App launch</b>, find IP Webcam Pro, turn off <b>Manage automatically</b>, then turn on <b>Auto-launch</b>, <b>Secondary launch</b> and <b>Run in background</b>.</string>
    <string name="guide_bg_default">Tap <b>App battery usage</b>, then choose <b>Unrestricted</b>.</string>

