    <!-- Panduan layar mati -->
    <string name="guide_title">Panduan Layar Mati</string>
    <string name="guide_intro">Selesaikan langkah berikut agar kamera tetap streaming setelah layar dimatikan dengan tombol power. Nama menu bisa sedikit berbeda tergantung versi sistem.</string>
    <string name="guide_device_label">Perangkat terdeteksi</string>
    <string name="guide_open_settings">Buka pengaturan</string>
    <string name="guide_status_done">Selesai</string>
    <string name="guide_status_pending">Belum</string>
    <string name="guide_status_restricted">Dibatasi</string>
    <string name="guide_status_optional">Opsional</string>
    <string name="guide_test_title">Cara menguji</string>
    <string name="guide_test_body">Tekan Mulai Server, matikan layar dengan tombol power, lalu buka URL stream di laptop. Jika video tetap bergerak, pengaturan sudah benar.</string>
    <string name="guide_open_failed">Halaman pengaturan tidak ditemukan. Buka Pengaturan › Aplikasi › IP Webcam Pro secara manual.</string>

    <string name="guide_step_battery_title">Abaikan pengoptimalan baterai</string>
    <string name="guide_step_battery_body">Pilih <b>Izinkan</b> pada dialog agar Android tidak menjeda aplikasi saat layar mati.</string>
    <string name="guide_step_background_title">Izinkan aktivitas latar belakang</string>
    <string name="guide_step_autostart_title">Izinkan peluncuran otomatis</string>
    <string name="guide_step_overlay_title">Tampilkan di atas aplikasi lain</string>
    <string name="guide_step_overlay_body">Diperlukan untuk menampilkan indikator kamera saat streaming di latar belakang.</string>
    <string name="guide_step_lock_title">Kunci aplikasi di menu Terbaru</string>
    <string name="guide_step_lock_body">Buka layar <b>Aplikasi terbaru</b>, tekan lama atau geser ke bawah kartu IP Webcam Pro, lalu pilih <b>Kunci</b> agar tidak ikut dibersihkan.</string>

    <string name="guide_bg_oppo">Ketuk <b>Penggunaan baterai</b>, lalu aktifkan <b>Izinkan aktivitas latar belakang</b> dan <b>Izinkan aktivitas latar depan</b>.</string>
    <string name="guide_bg_xiaomi">Ketuk <b>Penghemat baterai</b>, lalu pilih <b>Tidak ada pembatasan</b>.</string>
    <string name="guide_bg_vivo">Buka <b>Baterai › Manajemen konsumsi daya latar belakang</b>, cari IP Webcam Pro, lalu pilih <b>Izinkan</b>.</string>
    <string name="guide_bg_samsung">Ketuk <b>Baterai</b>, lalu pilih <b>Tidak dibatasi</b>. Pastikan juga aplikasi tidak ada di daftar <b>Aplikasi tidur</b> pada Baterai › Batas penggunaan latar belakang.</string>
    <string name="guide_bg_huawei">Buka <b>Peluncuran aplikasi</b>, cari IP Webcam Pro, matikan <b>Kelola secara otomatis</b>, lalu aktifkan <b>Luncurkan otomatis</b>, <b>Peluncuran sekunder</b>, dan <b>Jalankan di latar belakang</b>.</string>
    <string name="guide_bg_default">Ketuk <b>Penggunaan baterai aplikasi</b>, lalu pilih <b>Tidak dibatasi</b>.</string>

    <string name="guide_bg_path_oppo">Info aplikasi › Penggunaan baterai › Izinkan aktivitas latar belakang</string>
    <string name="guide_bg_path_xiaomi">Info aplikasi › Penghemat baterai › Tidak ada pembatasan</string>
